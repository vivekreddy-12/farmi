# ── Backend: Supabase (farmer accounts, profiles and orders) ─────────────────
# Find both in Supabase → Project Settings → API. These two values are public by
# design (they ship to the browser); the database rules protect the data.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# ── Order receipt emails via Resend (server-side only; never prefix with VITE_) ─
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# Optional: a domain verified at resend.com/domains. Leave blank to use Resend's test sender.
RESEND_EMAIL_DOMAIN=""
# Optional: who receives a copy of every order receipt.
ORDER_NOTIFICATION_EMAIL=""

# ── AI Studio (existing) ─────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
